# Server
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8090

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lanx
DB_USER=lanx
DB_PASSWORD=troque-aqui

# Container do Postgres (compose.yaml) - mesmos valores de DB_NAME/DB_USER/DB_PASSWORD
POSTGRES_DB=lanx
POSTGRES_USER=lanx
POSTGRES_PASSWORD=troque-aqui

# Gere com: openssl rand -base64 32
JWT_SECRET=

CORS_ORIGINS=http://localhost

# Usado só na primeira subida, quando não existe nenhum usuário
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CG Scraper Api URL
CG_API_URL=http://localhost:8000

# RabbitMQ
RABBITMQ_USER=lanx
RABBITMQ_PASSWORD=lanx
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/

# Anexos
ANEXOS_DIRETORIO=/data/uploads
ANEXOS_STORAGE_TIPO=local